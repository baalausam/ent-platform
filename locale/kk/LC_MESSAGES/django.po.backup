msgstr "%(field)s %(value)r бар %(model)s данасы дұрыс таңдау емес."

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:994
msgid "Foreign Key (type determined by related field)"
msgstr "Сыртқы кілт (түрі байланысты өріспен анықталады)"

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:1369
msgid "One-to-one relationship"
msgstr "Бір-бірге қатынас"

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:1426
#, python-format
msgid "%(from)s-%(to)s relationship"
msgstr "%(from)s-%(to)s қатынасы"

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:1428
#, python-format
msgid "%(from)s-%(to)s relationships"
msgstr "%(from)s-%(to)s қатынастары"

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:1476
msgid "Many-to-many relationship"
msgstr "Көптен-көпке қатынас"

