#, python-format
msgid "Please correct the duplicate data for %(field)s."
msgstr "%(field)s үшін қайталанатын деректерді түзетіңіз."

#: .\venv\Lib\site-packages\django\forms\models.py:931
#, python-format
msgid "Please correct the duplicate data for %(field)s, which must be unique."
msgstr ""
"%(field)s үшін қайталанатын деректерді түзетіңіз, ол бірегей болуы керек."

#: .\venv\Lib\site-packages\django\forms\models.py:938
#, python-format
msgid ""
"Please correct the duplicate data for %(field_name)s which must be unique "
"for the %(lookup)s in %(date_field)s."
msgstr ""
"%(date_field)s ішіндегі %(lookup)s үшін бірегей болуы керек %(field_name)s "
"үшін қайталанатын деректерді түзетіңіз."

#: .\venv\Lib\site-packages\django\forms\models.py:947
msgid "Please correct the duplicate values below."
msgstr "Төмендегі қайталанатын мәндерді түзетіңіз."

