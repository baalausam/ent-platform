msgstr ":?.!"

#: .\venv\Lib\site-packages\django\forms\fields.py:93
msgid "This field is required."
msgstr "Бұл өріс міндетті."

#: .\venv\Lib\site-packages\django\forms\fields.py:315
msgid "Enter a whole number."
msgstr "Бүтін санды енгізіңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:486
#: .\venv\Lib\site-packages\django\forms\fields.py:1246
msgid "Enter a valid date."
msgstr "Дұрыс күнді енгізіңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:509
#: .\venv\Lib\site-packages\django\forms\fields.py:1247
msgid "Enter a valid time."
msgstr "Дұрыс уақытты енгізіңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:536
msgid "Enter a valid date/time."
msgstr "Дұрыс күн/уақытты енгізіңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:570
msgid "Enter a valid duration."
msgstr "Дұрыс ұзақтықты енгізіңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:571
#, python-brace-format
msgid "The number of days must be between {min_days} and {max_days}."
msgstr "Күндер саны {min_days} мен {max_days} аралығында болуы керек."

#: .\venv\Lib\site-packages\django\forms\fields.py:640
msgid "No file was submitted. Check the encoding type on the form."
msgstr "Файл жіберілмеді. Форманың кодтау түрін тексеріңіз."

#: .\venv\Lib\site-packages\django\forms\fields.py:641
msgid "No file was submitted."
msgstr "Файл жіберілмеді."

#: .\venv\Lib\site-packages\django\forms\fields.py:642
msgid "The submitted file is empty."
msgstr "Жіберілген файл бос."

#: .\venv\Lib\site-packages\django\forms\fields.py:644
#, python-format
msgid "Ensure this filename has at most %(max)d character (it has %(length)d)."
msgid_plural ""
"Ensure this filename has at most %(max)d characters (it has %(length)d)."
msgstr[0] ""
"Бұл файл атауында ең көбі %(max)d таңба болуы керек (қазір %(length)d)."
msgstr[1] ""
"Бұл файл атауында ең көбі %(max)d таңба болуы керек (қазір %(length)d)."

#: .\venv\Lib\site-packages\django\forms\fields.py:649
msgid "Please either submit a file or check the clear checkbox, not both."
msgstr ""
"Файл жіберіңіз немесе тазалау құсбелгісін белгілеңіз, екеуін бірге емес."

#: .\venv\Lib\site-packages\django\forms\fields.py:717
msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Жарамды суретті жүктеңіз. Жүктелген файл сурет емес немесе бүлінген сурет."

#: .\venv\Lib\site-packages\django\forms\fields.py:864
