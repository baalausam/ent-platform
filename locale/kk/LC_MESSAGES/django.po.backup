msgstr "Екі бейіндік пәнді таңдаңыз."

#: .\core\views.py:412 .\core\views.py:2103
msgid "Профильные предметы должны быть разными."
msgstr "Бейіндік пәндер әртүрлі болуы керек."

#: .\core\views.py:521
msgid "У вас нет предметов для добавления вопросов."
msgstr "Сізде сұрақ қосуға арналған пәндер жоқ."

#: .\core\views.py:531
#, python-format
msgid "Бұл контекстке %(exp)s сұрақ қосу керек. Артық қосуға болмайды."
msgstr "Бұл контекстке %(exp)s сұрақ қосу керек. Артық қосуға болмайды."

#: .\core\views.py:548 .\core\views.py:1015
msgid "Вы не можете добавлять вопросы в этот блок."
msgstr "Сіз бұл блокқа сұрақ қоса алмайсыз."

#: .\core\views.py:557 .\core\views.py:1025
msgid "Только по своему предмету."
msgstr "Тек өз пәніңіз бойынша."

#: .\core\views.py:566 .\core\views.py:1035
msgid "Сәйкестендіру: 4 нұсқа + 2 кіші сұрақ қажет."
msgstr "Сәйкестендіру: 4 нұсқа + 2 кіші сұрақ қажет."

#: .\core\views.py:749
msgid "Сіз тек өз сұрақтарыңызды өшіре аласыз."
msgstr "Сіз тек өз сұрақтарыңызды өшіре аласыз."

#: .\core\views.py:796
msgid "Сіз тек өз черновиктеріңізді өшіре аласыз."
msgstr "Сіз тек өз черновиктеріңізді өшіре аласыз."

#: .\core\views.py:821 .\core\views.py:936
msgid "Контексті тек оқу сауаттылығы немесе бейіндік пән мұғалімі қоса алады."
msgstr "Контексті тек оқу сауаттылығы немесе бейіндік пән мұғалімі қоса алады."

#: .\core\views.py:872
msgid ""
"Контексты доступны только учителю грамотности чтения или профильного "
"предмета."
msgstr ""
"Контексттер тек оқу сауаттылығы немесе бейіндік пән мұғаліміне қолжетімді."

#: .\core\views.py:892
#, python-format
msgid ""
"Контекст толық емес: %(cur)s / %(exp)s сұрақ. Алдымен барлық сұрақтарды "
"қосыңыз."
msgstr ""
"Контекст толық емес: %(cur)s / %(exp)s сұрақ. Алдымен барлық сұрақтарды "
"қосыңыз."

#: .\core\views.py:902
msgid "Контексте бекітілмеген сұрақтар бар."
msgstr "Контексте бекітілмеген сұрақтар бар."

#: .\core\views.py:927
msgid "Бұл контексті өңдеуге құқығыңыз жоқ (тек черновиктерді өңдеуге болады)."
msgstr "Бұл контексті өңдеуге құқығыңыз жоқ (тек черновиктерді өңдеуге болады)."

#: .\core\views.py:996
msgid "Бұл сұрақты өңдеуге құқығыңыз жоқ."
msgstr "Бұл сұрақты өңдеуге құқығыңыз жоқ."

#: .\core\views.py:1966
msgid "Неверный логин или пароль."
msgstr "Логин немесе құпия сөз дұрыс емес."

#: .\core\views.py:2086
msgid "Старый пароль неверный."
msgstr "Ескі құпия сөз дұрыс емес."

#: .\core\views.py:2088
msgid "Новые пароли не совпадают."
msgstr "Жаңа құпия сөздер сәйкес келмейді."

#: .\core\views.py:2090
msgid "Пароль минимум 6 символов."
msgstr "Құпия сөз кемінде 6 таңбадан тұруы керек."

#: .\core\views.py:2113
msgid "Ошибка при сохранении."
msgstr "Сақтау кезінде қате орын алды."

#: .\core\views.py:2119
msgid "Выберите хотя бы одно."
msgstr "Кемінде біреуін таңдаңыз."

#: .\core\views.py:2124
msgid "Выберите хотя бы один предмет."
msgstr "Кемінде бір пәнді таңдаңыз."

#: .\core\views.py:2187
msgid "Сізде бұл сұрақты көруге құқық жоқ."
msgstr "Сізде бұл сұрақты көруге құқық жоқ."

#: .\core\views.py:2251
msgid "Сізде бұл контексті көруге құқық жоқ."
msgstr "Сізде бұл контексті көруге құқық жоқ."

#: .\mysite\settings.py:146
msgid "Қазақша"
msgstr "Қазақша"

#: .\venv\Lib\site-packages\django\contrib\messages\apps.py:16
msgid "Messages"
msgstr "Хабарламалар"

#: .\venv\Lib\site-packages\django\contrib\sitemaps\apps.py:8
msgid "Site Maps"
msgstr "Сайт карталары"

#: .\venv\Lib\site-packages\django\contrib\staticfiles\apps.py:9
msgid "Static Files"
msgstr "Статикалық файлдар"

#: .\venv\Lib\site-packages\django\contrib\syndication\apps.py:7
msgid "Syndication"
msgstr "Синдикация"

#. Translators: String used to replace omitted page numbers in elided page
#. range generated by paginators, e.g. [1, 2, '…', 5, 6, 7, '…', 9, 10].
#: .\venv\Lib\site-packages\django\core\paginator.py:33
msgid "…"
msgstr "…"

#: .\venv\Lib\site-packages\django\core\paginator.py:35
msgid "That page number is not an integer"
msgstr "Бет нөмірі бүтін сан емес"

#: .\venv\Lib\site-packages\django\core\paginator.py:36
msgid "That page number is less than 1"
msgstr "Бет нөмірі 1-ден кіші"

#: .\venv\Lib\site-packages\django\core\paginator.py:37
msgid "That page contains no results"
msgstr "Бұл бетте нәтижелер жоқ"

#: .\venv\Lib\site-packages\django\core\validators.py:22
msgid "Enter a valid value."
msgstr "Дұрыс мәнді енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:70
msgid "Enter a valid domain name."
msgstr "Дұрыс домен атауын енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:153
#: .\venv\Lib\site-packages\django\forms\fields.py:775
msgid "Enter a valid URL."
msgstr "Дұрыс URL енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:200
msgid "Enter a valid integer."
msgstr "Дұрыс бүтін санды енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:211
msgid "Enter a valid email address."
msgstr "Дұрыс email мекенжайын енгізіңіз."

#. Translators: "letters" means latin letters: a-z and A-Z.
#: .\venv\Lib\site-packages\django\core\validators.py:289
msgid ""
"Enter a valid “slug” consisting of letters, numbers, underscores or hyphens."
msgstr ""
"Әріптерден, сандардан, астыңғы сызықтан немесе дефистен тұратын дұрыс «slug» "
"енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:297
msgid ""
"Enter a valid “slug” consisting of Unicode letters, numbers, underscores, or "
"hyphens."
msgstr ""
"Unicode әріптерден, сандардан, астыңғы сызықтан немесе дефистен тұратын "
"дұрыс «slug» енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:309
#: .\venv\Lib\site-packages\django\core\validators.py:318
#: .\venv\Lib\site-packages\django\core\validators.py:332
#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2299
#, python-format
msgid "Enter a valid %(protocol)s address."
msgstr "Дұрыс %(protocol)s мекенжайын енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:311
msgid "IPv4"
msgstr "IPv4"

#: .\venv\Lib\site-packages\django\core\validators.py:320
#: .\venv\Lib\site-packages\django\utils\ipv6.py:43
msgid "IPv6"
msgstr "IPv6"

#: .\venv\Lib\site-packages\django\core\validators.py:334
msgid "IPv4 or IPv6"
msgstr "IPv4 немесе IPv6"

#: .\venv\Lib\site-packages\django\core\validators.py:375
msgid "Enter only digits separated by commas."
msgstr "Үтірмен бөлінген тек сандарды енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:381
#, python-format
msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr "Бұл мән %(limit_value)s болуы керек (қазір %(show_value)s)."

#: .\venv\Lib\site-packages\django\core\validators.py:416
#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Бұл мән %(limit_value)s-тен кіші немесе тең болуы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:425
#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Бұл мән %(limit_value)s-тен үлкен немесе тең болуы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:434
#, python-format
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Бұл мән %(limit_value)s қадамына еселік болуы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:441
#, python-format
msgid ""
"Ensure this value is a multiple of step size %(limit_value)s, starting from "
"%(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr ""
"Бұл мән %(offset)s-тен бастап %(limit_value)s қадамына еселік болуы керек, "
"мысалы %(offset)s, %(valid_value1)s, %(valid_value2)s, т.б."

#: .\venv\Lib\site-packages\django\core\validators.py:473
#, python-format
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at least %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Бұл мәнде кемінде %(limit_value)d таңба болуы керек (қазір %(show_value)d)."
msgstr[1] ""
"Бұл мәнде кемінде %(limit_value)d таңба болуы керек (қазір %(show_value)d)."

#: .\venv\Lib\site-packages\django\core\validators.py:491
#, python-format
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Бұл мәнде ең көбі %(limit_value)d таңба болуы керек (қазір %(show_value)d)."
msgstr[1] ""
"Бұл мәнде ең көбі %(limit_value)d таңба болуы керек (қазір %(show_value)d)."

#: .\venv\Lib\site-packages\django\core\validators.py:514
#: .\venv\Lib\site-packages\django\forms\fields.py:366
#: .\venv\Lib\site-packages\django\forms\fields.py:405
msgid "Enter a number."
msgstr "Санды енгізіңіз."

#: .\venv\Lib\site-packages\django\core\validators.py:516
#, python-format
msgid "Ensure that there are no more than %(max)s digit in total."
msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "Барлығы %(max)s саннан аспауы керек."
msgstr[1] "Барлығы %(max)s саннан аспауы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:521
#, python-format
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "Ондық бөлшекте %(max)s таңбадан аспауы керек."
msgstr[1] "Ондық бөлшекте %(max)s таңбадан аспауы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:526
#, python-format
msgid ""
"Ensure that there are no more than %(max)s digit before the decimal point."
msgid_plural ""
"Ensure that there are no more than %(max)s digits before the decimal point."
msgstr[0] "Ондық бөлшекке дейін %(max)s саннан аспауы керек."
msgstr[1] "Ондық бөлшекке дейін %(max)s саннан аспауы керек."

#: .\venv\Lib\site-packages\django\core\validators.py:597
#, python-format
msgid ""
"File extension “%(extension)s” is not allowed. Allowed extensions are: "
"%(allowed_extensions)s."
msgstr ""
"“%(extension)s” файл кеңейтіміне рұқсат етілмейді. Рұқсат етілген "
"кеңейтімдер: %(allowed_extensions)s."

#: .\venv\Lib\site-packages\django\core\validators.py:659
msgid "Null characters are not allowed."
msgstr "Нөлдік таңбаларға рұқсат етілмейді."

#: .\venv\Lib\site-packages\django\db\models\base.py:1666
#: .\venv\Lib\site-packages\django\forms\models.py:933
msgid "and"
msgstr "және"

#: .\venv\Lib\site-packages\django\db\models\base.py:1668
#, python-format
msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr "Осы %(field_labels)s бар %(model_name)s бұрыннан бар."

#: .\venv\Lib\site-packages\django\db\models\constraints.py:22
#, python-format
msgid "Constraint “%(name)s” is violated."
msgstr "“%(name)s” шектеуі бұзылды."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:94
msgid "- Select an option -"
msgstr "- Опцияны таңдаңыз -"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:143
#, python-format
msgid "Value %(value)r is not a valid choice."
msgstr "%(value)r мәні дұрыс таңдау емес."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:144
msgid "This field cannot be null."
msgstr "Бұл өріс бос болмауы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:145
msgid "This field cannot be blank."
msgstr "Бұл өріс бос болмауы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:146
#, python-format
msgid "%(model_name)s with this %(field_label)s already exists."
msgstr "Осы %(field_label)s бар %(model_name)s бұрыннан бар."

#. Translators: The 'lookup_type' is one of 'date', 'year' or
#. 'month'. Eg: "Title must be unique for pub_date year"
#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:150
#, python-format
msgid ""
"%(field_label)s must be unique for %(date_field_label)s %(lookup_type)s."
msgstr ""
"%(field_label)s %(date_field_label)s %(lookup_type)s үшін бірегей болуы "
"керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:187
#, python-format
msgid "Field of type: %(field_type)s"
msgstr "Өріс түрі: %(field_type)s"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1203
#, python-format
msgid "“%(value)s” value must be either True or False."
msgstr "“%(value)s” мәні True немесе False болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1204
#, python-format
msgid "“%(value)s” value must be either True, False, or None."
msgstr "“%(value)s” мәні True, False немесе None болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1206
msgid "Boolean (Either True or False)"
msgstr "Boolean (True немесе False)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1256
#, python-format
msgid "String (up to %(max_length)s)"
msgstr "Жол (%(max_length)s таңбаға дейін)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1258
msgid "String (unlimited)"
msgstr "Жол (шектеусіз)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1367
msgid "Comma-separated integers"
msgstr "Үтірмен бөлінген бүтін сандар"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1468
#, python-format
msgid ""
"“%(value)s” value has an invalid date format. It must be in YYYY-MM-DD "
"format."
msgstr ""
"“%(value)s” мәнінің күн форматы дұрыс емес. YYYY-MM-DD форматында болуы "
"керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1472
#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1607
#, python-format
msgid ""
"“%(value)s” value has the correct format (YYYY-MM-DD) but it is an invalid "
"date."
msgstr "“%(value)s” мәнінің форматы дұрыс (YYYY-MM-DD), бірақ күн жарамсыз."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1476
msgid "Date (without time)"
msgstr "Күн (уақытсыз)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1603
#, python-format
msgid ""
"“%(value)s” value has an invalid format. It must be in YYYY-MM-DD HH:MM[:ss[."
"uuuuuu]][TZ] format."
msgstr ""
"“%(value)s” мәнінің форматы дұрыс емес. YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ] "
"форматында болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1611
#, python-format
msgid ""
"“%(value)s” value has the correct format (YYYY-MM-DD HH:MM[:ss[.uuuuuu]]"
"[TZ]) but it is an invalid date/time."
msgstr ""
"“%(value)s” мәнінің форматы дұрыс (YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ]), "
"бірақ күн/уақыт жарамсыз."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1616
msgid "Date (with time)"
msgstr "Күн (уақытпен)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1743
#, python-format
msgid "“%(value)s” value must be a decimal number."
msgstr "“%(value)s” мәні ондық сан болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1745
msgid "Decimal number"
msgstr "Ондық сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1947
#, python-format
msgid ""
"“%(value)s” value has an invalid format. It must be in [DD] [[HH:]MM:]ss[."
"uuuuuu] format."
msgstr ""
"“%(value)s” мәнінің форматы дұрыс емес. [DD] [[HH:]MM:]ss[.uuuuuu] "
"форматында болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1951
msgid "Duration"
msgstr "Ұзақтығы"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:1999
msgid "Email address"
msgstr "Email мекенжайы"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2024
msgid "File path"
msgstr "Файл жолы"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2102
#, python-format
msgid "“%(value)s” value must be a float."
msgstr "“%(value)s” мәні нақты сан болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2104
msgid "Floating point number"
msgstr "Нақты сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2144
#, python-format
msgid "“%(value)s” value must be an integer."
msgstr "“%(value)s” мәні бүтін сан болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2146
msgid "Integer"
msgstr "Бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2242
msgid "Big (8 byte) integer"
msgstr "Үлкен (8 байт) бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2259
msgid "Small integer"
msgstr "Кіші бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2267
msgid "IPv4 address"
msgstr "IPv4 мекенжайы"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2298
msgid "IP address"
msgstr "IP мекенжайы"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2389
#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2390
#, python-format
msgid "“%(value)s” value must be either None, True or False."
msgstr "“%(value)s” мәні None, True немесе False болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2392
msgid "Boolean (Either True, False or None)"
msgstr "Boolean (True, False немесе None)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2443
msgid "Positive big integer"
msgstr "Оң үлкен бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2458
msgid "Positive integer"
msgstr "Оң бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2473
msgid "Positive small integer"
msgstr "Оң кіші бүтін сан"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2489
#, python-format
msgid "Slug (up to %(max_length)s)"
msgstr "Slug (%(max_length)s таңбаға дейін)"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2525
msgid "Text"
msgstr "Мәтін"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2605
#, python-format
msgid ""
"“%(value)s” value has an invalid format. It must be in HH:MM[:ss[.uuuuuu]] "
"format."
msgstr ""
"“%(value)s” мәнінің форматы дұрыс емес. HH:MM[:ss[.uuuuuu]] форматында болуы "
"керек."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2609
#, python-format
msgid ""
"“%(value)s” value has the correct format (HH:MM[:ss[.uuuuuu]]) but it is an "
"invalid time."
msgstr ""
"“%(value)s” мәнінің форматы дұрыс (HH:MM[:ss[.uuuuuu]]), бірақ уақыт "
"жарамсыз."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2613
msgid "Time"
msgstr "Уақыт"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2721
msgid "URL"
msgstr "URL"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2745
msgid "Raw binary data"
msgstr "Шикі екілік деректер"

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2748
#, python-format
msgid "“%(value)s” is not a valid binary value."
msgstr "“%(value)s” жарамды екілік мән емес."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2821
#, python-format
msgid "“%(value)s” is not a valid UUID."
msgstr "“%(value)s” жарамды UUID емес."

#: .\venv\Lib\site-packages\django\db\models\fields\__init__.py:2823
msgid "Universally unique identifier"
msgstr "Әмбебап бірегей идентификатор"

#: .\venv\Lib\site-packages\django\db\models\fields\files.py:247
msgid "File"
msgstr "Файл"

#: .\venv\Lib\site-packages\django\db\models\fields\files.py:423
msgid "Image"
msgstr "Сурет"

#: .\venv\Lib\site-packages\django\db\models\fields\json.py:26
msgid "A JSON object"
msgstr "JSON нысаны"

#: .\venv\Lib\site-packages\django\db\models\fields\json.py:28
msgid "Value must be valid JSON."
msgstr "Мән жарамды JSON болуы керек."

#: .\venv\Lib\site-packages\django\db\models\fields\related.py:991
#, python-format
