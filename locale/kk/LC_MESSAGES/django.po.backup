msgid "Forbidden"
msgstr "Тыйым салынған"

#: .\venv\Lib\site-packages\django\views\csrf.py:31
msgid "CSRF verification failed. Request aborted."
msgstr "CSRF тексеруі сәтсіз аяқталды. Сұраныс тоқтатылды."

#: .\venv\Lib\site-packages\django\views\csrf.py:35
msgid ""
"You are seeing this message because this HTTPS site requires a “Referer "
"header” to be sent by your web browser, but none was sent. This header is "
"required for security reasons, to ensure that your browser is not being "
"hijacked by third parties."
msgstr ""
"Сіз бұл хабарламаны көріп отырсыз, себебі бұл HTTPS сайты веб-браузеріңізден "
"“Referer header” жіберуді талап етеді, бірақ ол жіберілмеді. Бұл тақырып "
"қауіпсіздік себептерімен қажет, браузеріңіз үшінші тараптармен ұрланбауы "
"үшін."

#: .\venv\Lib\site-packages\django\views\csrf.py:41
msgid ""
"If you have configured your browser to disable “Referer” headers, please re-"
"enable them, at least for this site, or for HTTPS connections, or for “same-"
"origin” requests."
msgstr ""
"Егер браузеріңізді “Referer” тақырыптарын өшіруге баптаған болсаңыз, оларды "
"қайта қосыңыз, кемінде осы сайт үшін, немесе HTTPS қосылымдары үшін, немесе "
"“same-origin” сұраныстары үшін."

#: .\venv\Lib\site-packages\django\views\csrf.py:46
msgid ""
"If you are using the <meta name=\"referrer\" content=\"no-referrer\"> tag or "
"including the “Referrer-Policy: no-referrer” header, please remove them. The "
"CSRF protection requires the “Referer” header to do strict referer checking. "
"If you’re concerned about privacy, use alternatives like <a "
"rel=\"noreferrer\" …> for links to third-party sites."
msgstr ""
"Егер <meta name=\"referrer\" content=\"no-referrer\"> тегін немесе “Referrer-"
"Policy: no-referrer” тақырыбын қолдансаңыз, оларды жойыңыз. CSRF қорғанысы "
"қатаң referer тексеруі үшін “Referer” тақырыбын талап етеді. Құпиялылық "
"туралы алаңдасаңыз, үшінші тарап сайттарына сілтемелер үшін <a "
"rel=\"noreferrer\" …> сияқты баламаларды қолданыңыз."

#: .\venv\Lib\site-packages\django\views\csrf.py:55
msgid ""
"You are seeing this message because this site requires a CSRF cookie when "
"submitting forms. This cookie is required for security reasons, to ensure "
"that your browser is not being hijacked by third parties."
msgstr ""
"Сіз бұл хабарламаны көріп отырсыз, себебі бұл сайт формаларды жіберу кезінде "
"CSRF cookie талап етеді. Бұл cookie қауіпсіздік себептерімен қажет, "
"браузеріңіз үшінші тараптармен ұрланбауы үшін."

#: .\venv\Lib\site-packages\django\views\csrf.py:61
msgid ""
"If you have configured your browser to disable cookies, please re-enable "
"them, at least for this site, or for “same-origin” requests."
msgstr ""
"Егер браузеріңізді cookie өшіруге баптаған болсаңыз, оларды қайта қосыңыз, "
"кемінде осы сайт үшін, немесе “same-origin” сұраныстары үшін."

#: .\venv\Lib\site-packages\django\views\csrf.py:67
msgid "More information is available with DEBUG=True."
msgstr "Қосымша ақпарат DEBUG=True кезінде қолжетімді."

#: .\venv\Lib\site-packages\django\views\generic\dates.py:44
msgid "No year specified"
msgstr "Жыл көрсетілмеген"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:64
#: .\venv\Lib\site-packages\django\views\generic\dates.py:115
#: .\venv\Lib\site-packages\django\views\generic\dates.py:214
msgid "Date out of range"
msgstr "Күн ауқымнан тыс"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:94
msgid "No month specified"
msgstr "Ай көрсетілмеген"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:147
msgid "No day specified"
msgstr "Күн көрсетілмеген"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:194
msgid "No week specified"
msgstr "Апта көрсетілмеген"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:353
#: .\venv\Lib\site-packages\django\views\generic\dates.py:384
#, python-format
msgid "No %(verbose_name_plural)s available"
msgstr "%(verbose_name_plural)s қолжетімсіз"

#: .\venv\Lib\site-packages\django\views\generic\dates.py:680
#, python-format
msgid ""
"Future %(verbose_name_plural)s not available because %(class_name)s."
"allow_future is False."
msgstr ""
"Болашақ %(verbose_name_plural)s қолжетімсіз, себебі %(class_name)s."
"allow_future False."

#: .\venv\Lib\site-packages\django\views\generic\dates.py:720
#, python-format
msgid "Invalid date string “%(datestr)s” given format “%(format)s”"
msgstr "“%(format)s” форматындағы “%(datestr)s” күн жолы жарамсыз"

#: .\venv\Lib\site-packages\django\views\generic\detail.py:56
#, python-format
msgid "No %(verbose_name)s found matching the query"
msgstr "Сұранысқа сәйкес %(verbose_name)s табылмады"

#: .\venv\Lib\site-packages\django\views\generic\list.py:70
msgid "Page is not “last”, nor can it be converted to an int."
msgstr "Бет “соңғы” емес, оны int-ке түрлендіру мүмкін емес."

#: .\venv\Lib\site-packages\django\views\generic\list.py:77
#, python-format
msgid "Invalid page (%(page_number)s): %(message)s"
msgstr "Жарамсыз бет (%(page_number)s): %(message)s"

#: .\venv\Lib\site-packages\django\views\generic\list.py:173
#, python-format
msgid "Empty list and “%(class_name)s.allow_empty” is False."
msgstr "Бос тізім және “%(class_name)s.allow_empty” False."

#: .\venv\Lib\site-packages\django\views\static.py:49
msgid "Directory indexes are not allowed here."
msgstr "Мұнда каталог индекстеріне рұқсат етілмейді."

#: .\venv\Lib\site-packages\django\views\static.py:51
#, python-format
msgid "“%(path)s” does not exist"
msgstr "“%(path)s” жоқ"

#: .\venv\Lib\site-packages\django\views\static.py:68
#: .\venv\Lib\site-packages\django\views\templates\directory_index.html:9
#: .\venv\Lib\site-packages\django\views\templates\directory_index.html:12
#, python-format
msgid "Index of %(directory)s"
msgstr "%(directory)s индексі"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:7
#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:197
msgid "The install worked successfully! Congratulations!"
msgstr "Орнату сәтті өтті! Құттықтаймыз!"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:199
#, python-format
msgid ""
"View <a href=\"https://docs.djangoproject.com/en/%(version)s/releases/\" "
"target=\"_blank\" rel=\"noopener\">release notes</a> for Django %(version)s"
msgstr ""
"Django %(version)s үшін <a href=\"https://docs.djangoproject.com/en/"
"%(version)s/releases/\" target=\"_blank\" rel=\"noopener\">release notes</a> "
"қараңыз"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:201
#, python-format
msgid ""
"You are seeing this page because <a href=\"https://docs.djangoproject.com/en/"
"%(version)s/ref/settings/#debug\" target=\"_blank\" "
"rel=\"noopener\">DEBUG=True</a> is in your settings file and you have not "
"configured any URLs."
msgstr ""
"Сіз бұл бетті көріп отырсыз, себебі параметрлер файлыңызда <a href=\"https://"
"docs.djangoproject.com/en/%(version)s/ref/settings/#debug\" "
"target=\"_blank\" rel=\"noopener\">DEBUG=True</a> орнатылған және ешбір URL "
"бапталмаған."

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:220
msgid "Django Documentation"
msgstr "Django құжаттамасы"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:221
msgid "Topics, references, &amp; how-to’s"
msgstr "Тақырыптар, анықтамалар және нұсқаулықтар"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:229
msgid "Tutorial: A Polling App"
msgstr "Оқулық: Дауыс беру қолданбасы"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:230
msgid "Get started with Django"
msgstr "Django-мен бастау"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:238
msgid "Django Community"
msgstr "Django қауымдастығы"

#: .\venv\Lib\site-packages\django\views\templates\default_urlconf.html:239
msgid "Connect, get help, or contribute"
msgstr "Қосылыңыз, көмек алыңыз немесе үлес қосыңыз"

